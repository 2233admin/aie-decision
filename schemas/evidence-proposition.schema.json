{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aie-decision.local/schemas/v1/evidence-proposition.schema.json",
  "title": "AIE Evidence Proposition v1",
  "type": "object",
  "required": ["schema_version", "evidence_atom_id", "source_id", "source_locator", "claim", "epistemic_type", "independence_group", "target_relevance", "extraction_confidence", "truth_confidence", "provenance", "revision"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "evidence_atom_id": {"type": "string"}, "source_id": {"type": "string"}, "source_locator": {"type": "string"}, "speaker": {"type": ["string", "null"]}, "claim": {"type": "string"},
    "epistemic_type": {"enum": ["observed_event", "primary_record", "attributed_statement", "inference", "causal_claim", "forecast", "evaluation", "rhetoric", "omission"]},
    "independence_group": {"type": "string"}, "target_relevance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "truth_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/provenance"}}, "revision": {"$ref": "common.schema.json#/$defs/revision"}
  },
  "additionalProperties": true
}
