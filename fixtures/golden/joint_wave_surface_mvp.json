{
  "fixture_version": "1.0.0",
  "fixture_id": "joint-wave-surface-mvp",
  "schema_version": "joint-wave-surface-mvp.v1",
  "scenario": "deliver an outcome with delivery_time, price, and magnitude across two regimes; expect bimodal surface, structured failures for illegal units, and at least one diagnostic-driven loop iteration",
  "outcome_space": {
    "axes": [
      {
        "name": "delivery_time",
        "unit": "hour",
        "domain": [0, 48],
        "time_semantics": "elapsed",
        "tolerance": {"kind": "absolute", "value": 2.0, "unit": "hour"}
      },
      {
        "name": "price",
        "unit": "usd",
        "domain": [0, 200],
        "tolerance": {"kind": "relative", "value": 0.25, "unit": "usd"}
      },
      {
        "name": "magnitude",
        "unit": "dimensionless",
        "domain": [0, 10],
        "tolerance": {"kind": "loss_threshold", "value": 0.5, "unit": "dimensionless"}
      }
    ]
  },
  "variables": [
    {"name": "lane_hours", "unit": "hour", "lower": 18.0, "upper": 22.0, "method": "observed"},
    {"name": "rest_hours", "unit": "hour", "lower": 6.0, "upper": 10.0, "method": "observed"},
    {"name": "delay_proxy", "unit": "hour", "lower": 0.0, "upper": 6.0, "method": "assumed", "bimodal": true},
    {"name": "fuel_unit_cost", "unit": "usd/liter", "lower": 0.9, "upper": 1.3, "method": "observed"},
    {"name": "liters_per_leg", "unit": "liter", "lower": 18.0, "upper": 26.0, "method": "assumed"},
    {"name": "severity_factor", "unit": "dimensionless", "lower": 0.4, "upper": 0.6, "method": "observed", "ablatable": true},
    {"name": "regime_factor", "unit": "dimensionless", "lower": 0.0, "upper": 2.0, "method": "observed", "bimodal": true}
  ],
  "mappings": [
    {
      "mapping_id": "time-leg",
      "formula": "lane_hours + rest_hours + delay_proxy",
      "output_axes": ["delivery_time"],
      "expected_unit": "hour"
    },
    {
      "mapping_id": "price-fuel",
      "formula": "fuel_unit_cost * liters_per_leg",
      "output_axes": ["price"],
      "expected_unit": "usd"
    },
    {
      "mapping_id": "magnitude-fuel",
      "formula": "regime_factor * severity_factor",
      "output_axes": ["magnitude"],
      "expected_unit": "dimensionless"
    },
    {
      "mapping_id": "illegitimate-time-constant",
      "formula": "lane_hours + 3",
      "output_axes": ["delivery_time"],
      "expected_unit": "hour",
      "expect_failure": "unit_mismatch"
    },
    {
      "mapping_id": "illegitimate-time-money",
      "formula": "lane_hours + fuel_unit_cost",
      "output_axes": ["delivery_time"],
      "expected_unit": "hour",
      "expect_failure": "unit_mismatch"
    }
  ],
  "regime_split": {
    "split_variable": "delay_proxy",
    "thresholds": [3.0],
    "modes": ["fast", "slow"]
  },
  "particles": {"count": 256, "seed": 20260805},
  "budget": {
    "max_rounds": 3,
    "max_actions_per_round": 2,
    "max_seconds": 5.0
  },
  "decision_policy": {
    "axes": {
      "delivery_time": {"kind": "absolute", "value": 2.0, "unit": "hour"},
      "price": {"kind": "relative", "value": 0.25, "unit": "usd"},
      "magnitude": {"kind": "loss_threshold", "value": 0.5, "unit": "dimensionless"}
    }
  },
  "compatibility": {
    "use_candidate_generation_failure_diagnostic": true,
    "use_search_replay_for_ledger_validation": true
  },
  "expected_summary": {
    "axis_count": 3,
    "axis_order": ["delivery_time", "price", "magnitude"],
    "particle_count": 256,
    "deterministic_seed": 20260805,
    "wave_shape": "bimodal",
    "surface_kind": "possibility_surface",
    "expected_bimodal_axis": "delivery_time",
    "minimum_modes": 2,
    "expected_action_kinds": ["split_regime", "stop"],
    "expected_illegal_mapping_count": 2
  }
}
